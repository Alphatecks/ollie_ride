{
  "expo": {
    "name": "Ollie Ride Driver",
    "slug": "Ollie-Ride-Driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C3569"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show your current position on the map.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location even when the app is running in the background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sparklesix.ollieridedriver",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCwiyu1HxfDQFf5A9U4g_m4YLI21EzVuLg"
          }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["@config-plugins/react-native-webrtc"],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ollie Ride to access your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ollie Ride access to your photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "44259f3e-1c7f-4497-b292-5604ba44cd06"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/44259f3e-1c7f-4497-b292-5604ba44cd06"
    }
  }
}
